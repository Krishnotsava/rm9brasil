<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /blog/

  # If request has trailing slash (and is not a real directory), redirect to remove it
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^ %1 [R=301,L]

  # If the requested file or directory exists, serve it directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Rewrite everything else to post-template.html
  RewriteRule ^(.*)$ post-template.html [L]
</IfModule>
